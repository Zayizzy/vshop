generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  openid    String   @unique
  unionId   String?  @unique
  nickname  String?
  avatar    String?
  phone     String?
  location  String?
  isKoc        Boolean   @default(false)
  kocApprovedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  cartItems CartItem[]
  coupons   UserCoupon[]
  kocProfile KocProfile?
  chatSessions ChatSession[]
  aftersales Aftersale[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  province  String
  city      String
  district  String
  detail    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User     @relation(fields: [userId], references: [id])
  orders Order[]
}

model Category {
  id     String  @id @default(cuid())
  name   String
  icon   String?
  sort   Int     @default(0)
  status String  @default("active")

  subCategories SubCategory[]
}

model SubCategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  sort       Int      @default(0)

  category Category @relation(fields: [categoryId], references: [id])
  goods    Good[]
}

model Good {
  id            String   @id @default(cuid())
  subCategoryId String?
  name          String
  description   String?
  detail        String?
  sales         Int      @default(0)
  status        String   @default("active")
  // 商品级折扣率（0~1，如 0.8 = 8折）。null 表示无折扣。
  // 展示与下单均按 price × discountRate 计算折后价。
  discountRate  Float?
  // 是否为今日推荐商品（首页"今日推荐"展示）
  isRecommended Boolean  @default(false)
  // 推荐排序（越小越靠前）
  recommendSort Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subCategory SubCategory?  @relation(fields: [subCategoryId], references: [id])
  skus        Sku[]
  images      GoodImage[]
  detailImages GoodDetailImage[]
  suppliers   GoodSupplier[]
  favorites   Favorite[]

  @@index([status])
  @@index([isRecommended, recommendSort])
}

model GoodImage {
  id      String @id @default(cuid())
  goodId  String
  url     String @db.Text
  sort    Int    @default(0)

  good Good @relation(fields: [goodId], references: [id])
}

// 商品详情图（详情页纵向铺图展示，按 sort 升序）
model GoodDetailImage {
  id      String @id @default(cuid())
  goodId  String
  url     String @db.Text
  sort    Int    @default(0)

  good Good @relation(fields: [goodId], references: [id])
}

model Sku {
  id           String  @id @default(cuid())
  goodId       String
  name         String
  // 多规格维度组合，MySQL 原生 JSON：[{"name":"颜色","value":"红"},...]。
  // 为空表示单规格（回退 name 展示，兼容旧数据）。
  specValues   Json?
  // 金额以「分」为单位（Int），避免浮点累计误差。Service 层转「元」对外
  price        Int
  marketPrice  Int?
  stock        Int     @default(0)
  // 店管家平台商品规格 id（product/items/upload 成功回写，代发订单对账用）
  platformSkuId String?

  good         Good           @relation(fields: [goodId], references: [id])
  suppliers    GoodSupplier[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
}

model Supplier {
  id              String  @id @default(cuid())
  name            String
  contactName     String?
  contactPhone    String?
  deliveryRegions Json? // JSON array of cities
  fulfillRate     Float   @default(100)
  status          String  @default("active")
  createdAt       DateTime @default(now())

  goodSuppliers GoodSupplier[]
  orders        Order[]
}

model GoodSupplier {
  id         String  @id @default(cuid())
  goodId     String
  supplierId String
  skuId      String
  // 金额以「分」为单位（Int）
  price      Int
  stock      Int     @default(0)
  freight    Int     @default(0)
  status     String  @default("active")

  good     Good     @relation(fields: [goodId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  sku      Sku      @relation(fields: [skuId], references: [id])
}

model CartItem {
  id       String @id @default(cuid())
  userId   String
  skuId    String
  quantity Int    @default(1)

  user User @relation(fields: [userId], references: [id])
  sku  Sku  @relation(fields: [skuId], references: [id])

  @@index([userId, skuId])
}

model Order {
  id            String   @id @default(cuid())
  orderSn       String   @unique
  userId        String
  addressId     String?
  supplierId    String?
  status        String   @default("pending") // pending, shipping, receiving, done
  // 金额以「分」为单位（Int）
  totalAmount   Int
  discountAmount Int     @default(0)
  freightAmount Int      @default(0)
  payAmount     Int
  remark        String?
  // 店管家平台单号（trade/order/upload 成功回写；发货回调 all.order.send 对账用）
  platformOrderId String?
  // 店管家同步状态：synced=已同步 failed=同步失败 null=未同步
  dianjiaSyncStatus String?
  // 最近一次同步时间
  dianjiaSyncedAt  DateTime?
  kocId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  address   Address?   @relation(fields: [addressId], references: [id])
  supplier  Supplier?  @relation(fields: [supplierId], references: [id])
  items     OrderItem[]
  packages  OrderPackage[]
  payment   Payment?
  aftersales Aftersale[]

  @@index([status])
  @@index([userId, status])
  @@index([dianjiaSyncStatus])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  skuId     String
  goodTitle String
  specName  String?
  image     String?
  // 单价以「分」为单位（Int）
  price     Int
  quantity  Int

  order Order @relation(fields: [orderId], references: [id])
  sku   Sku   @relation(fields: [skuId], references: [id])
}

model OrderPackage {
  id            String  @id @default(cuid())
  orderId       String
  supplierId    String?
  supplierName  String
  status        Int     @default(0) // 0待发货 1已打单 2已发货 3运输中 4派送中 5已签收
  expressCompany String?
  expressNo     String?

  order Order @relation(fields: [orderId], references: [id])
}

model Payment {
  id           String   @id @default(cuid())
  orderId      String   @unique
  // 金额以「分」为单位（Int）
  amount       Int
  status       String   @default("pending")
  payTime      DateTime?
  // 微信支付交易号（支付成功回写，退款/对账用）
  transactionId String?
  // 预支付ID（统一下单返回，排查用）
  prepayId      String?
  // 支付渠道：wechatpay / mock
  provider      String?  @default("wechatpay")
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Favorite {
  id      String   @id @default(cuid())
  userId  String
  goodId  String
  createdAt DateTime @default(now())

  good Good @relation(fields: [goodId], references: [id])

  @@unique([userId, goodId])
}

model Coupon {
  id            String   @id @default(cuid())
  name          String
  type          String   // cash | discount
  // 现金券面额（分）。type=cash 时使用
  value         Int?
  // 折扣率（0~1，如 0.85）。type=discount 时使用，非金额故仍 Float
  discountValue Float?
  // 满减门槛（分）
  minAmount     Int      @default(0)
  scopeType     String   @default("all")
  totalCount    Int
  usedCount     Int      @default(0)
  expireTime    DateTime
  // active | disabled。disabled 后不再发放，已发放的不影响使用
  status        String   @default("active")
  userCoupons   UserCoupon[]
}

model UserCoupon {
  id       String   @id @default(cuid())
  userId   String
  couponId String
  status   String   @default("usable") // usable, used, expired
  usedAt   DateTime?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])
}

model ChannelReport {
  id        String   @id @default(cuid())
  source    String   // koc | card
  kocId     String?
  batchId   String?
  createdAt DateTime @default(now())

  @@index([kocId])
  @@index([batchId])
}

// KOC（分销员）申请资料 + 审核状态 + 佣金配置
// status: pending(审核中) | approved(已通过) | rejected(已驳回) | disabled(后台停用)
model KocProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  realName        String
  phone           String
  socialAccount   String?
  introduction    String?
  status          String   @default("pending")
  rejectReason    String?
  // 佣金率 0~1，null 表示用系统默认阶梯（按 orderCount 0.05/0.07/0.1）
  commissionRate  Float?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ===== 客服在线留言会话 =====
model ChatSession {
  id          String   @id @default(cuid())
  userId      String
  goodId      String?  // 商品页发起时携带，可为空
  title       String?  // 会话标题（商品名或「客服咨询」）
  lastMessage String?  // 最近一条消息内容（冗余，列表展示用）
  lastAt      DateTime @default(now())  // 最近消息时间，列表排序用
  // 未读计数：userUnread = 客服回了用户没看；adminUnread = 用户发了客服没看
  userUnread  Int @default(0)
  adminUnread Int @default(0)
  closed      Boolean  @default(false) // 客服可关闭会话
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  sender    String   // "user" | "admin"
  content   String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ===== 订单售后 / 退货退款 =====
// type: 1=仅退款 2=退货退款
// status: 0待审核 1已同意 2已拒绝 3退款中 4已退款 5已完成
// 金额以「分」为单位（Int），边界 yuanToCent / centToYuan 转换
model Aftersale {
  id             String   @id @default(cuid())
  aftersaleSn    String   @unique
  userId         String
  orderId        String
  orderItemId    String?
  packageIndex   Int      @default(0)
  type           Int
  reason         String
  description    String?
  // 凭证图 URL 数组，以 MySQL 原生 JSON 存储
  evidenceImages Json
  refundAmount   Int
  refundNo       String?
  // 微信退款单号（区别于自生成的 refundNo=out_refund_no）
  refundId       String?
  // 微信退款状态：PROCESSING / SUCCESS / CLOSED / ABNORMAL
  refundStatus  String?
  adminRemark    String?
  status         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

// 通用应用设置（key/value），如店管家自动同步开关 dianjia_auto_sync=true|false
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
