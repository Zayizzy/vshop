# MySQL 数据库连接字符串
# 请替换用户名、密码、主机和数据库名
DATABASE_URL="mysql://root:password@localhost:3307/vshop"

# JWT 签名密钥（生产环境请使用强随机字符串）
JWT_SECRET="your-jwt-secret-here"

# 后台管理员账号，格式：username:role:name:passwordHash,...
# role: super=超管, ops=运营
# 生成密码哈希：node -e "console.log(require('bcryptjs').hashSync('你的密码', 10))"
ADMIN_ACCOUNTS="admin:super:超级管理员:$2b$10$替换为bcrypt哈希,ops:ops:运营:$2b$10$替换为bcrypt哈希"
