<view class="page">
  <!-- 状态标签 -->
  <t-tabs value="{{activeTab}}" bind:change="onTabChange" space-evenly>
    <t-tab-panel wx:for="{{statusTabs}}" wx:key="key" value="{{item.key}}" label="{{item.label}}" />
  </t-tabs>

  <!-- 日期筛选 -->
  <view class="date-filter-bar">
    <view class="date-picker-trigger" bindtap="openStartPicker">
      <text class="date-label {{startDate ? 'active' : ''}}">{{startDate || '开始日期'}}</text>
      <text class="date-arrow">▼</text>
    </view>
    <text class="date-separator">-</text>
    <view class="date-picker-trigger" bindtap="openEndPicker">
      <text class="date-label {{endDate ? 'active' : ''}}">{{endDate || '结束日期'}}</text>
      <text class="date-arrow">▼</text>
    </view>
    <view wx:if="{{startDate || endDate}}" class="reset-btn" bindtap="resetDateFilter">重置</view>
    <view class="export-btn" bindtap="exportOrders">导出</view>
  </view>

  <!-- 空状态 -->
  <t-empty wx:if="{{orders.length === 0 && !loading}}" icon="order" description="暂无相关订单" />

  <!-- 订单列表 -->
  <view class="order-list">
    <block wx:for="{{orders}}" wx:key="id">
      <view class="order-card" bindtap="goDetail" data-id="{{item.id}}">
        <!-- 头部 -->
        <view class="order-header">
          <view class="order-header-left">
            <text class="order-sn">订单号：{{item.orderSn}}</text>
            <text wx:if="{{item.createdAtText}}" class="order-time">{{item.createdAtText}}</text>
          </view>
          <t-tag
            theme="{{item.status === 'shipping' ? 'warning' : (item.status === 'done' ? 'success' : (item.status === 'receiving' ? 'primary' : 'default'))}}"
            size="small" variant="light"
          >{{getStatusBadge(item.status).text}}</t-tag>
        </view>

        <!-- 包裹 -->
        <block wx:for="{{item.packages}}" wx:for-item="pkg" wx:for-index="pkgIdx" wx:key="supplierId">
          <view class="package-section">
            <view class="package-label">
              <text>{{pkg.supplierName}}</text>
              <text wx:if="{{pkg.logisticsType}}" class="logistics-badge">{{pkg.logisticsType}}</text>
            </view>

            <view class="goods-item" wx:for="{{pkg.items}}" wx:for-item="goods" wx:key="id">
              <t-image src="{{goods.coverImage}}" width="100rpx" height="100rpx" mode="aspectFill" shape="round" />
              <view class="goods-info">
                <text class="goods-title text-ellipsis-2">{{goods.title}}</text>
                <text class="goods-spec" wx:if="{{goods.specName}}">{{goods.specName}}</text>
              </view>
              <view class="goods-right">
                <text class="goods-price">¥{{goods.price}}</text>
                <text class="goods-qty">x{{goods.quantity}}</text>
              </view>
            </view>
          </view>
        </block>

        <!-- 底部 -->
        <view class="order-footer">
          <text class="order-total">共{{item.totalCount}}件 合计</text>
          <text class="order-price">¥{{item.totalAmount}}</text>
        </view>

        <!-- 操作按钮 -->
        <view class="order-actions" wx:if="{{item.status !== 'done' && item.status !== 'pending'}}">
          <t-button theme="default" variant="outline" size="small" catch:tap="goLogistics" data-id="{{item.id}}">查看物流</t-button>
          <t-button wx:if="{{item.status === 'receiving'}}" theme="primary" size="small" catch:tap="confirmReceive" data-id="{{item.id}}">确认收货</t-button>
        </view>

        <view class="order-actions" wx:if="{{item.status === 'pending'}}">
          <t-button theme="default" variant="outline" size="small">取消订单</t-button>
          <t-button theme="primary" size="small" catch:tap="goPay" data-id="{{item.id}}">去付款</t-button>
        </view>

        <view class="order-actions" wx:if="{{item.status === 'done'}}">
          <t-button theme="primary" variant="outline" size="small" catch:tap="rebuy" data-id="{{item.id}}">再次购买</t-button>
        </view>
      </view>
    </block>
  </view>

  <!-- 加载动画 -->
  <view class="loading-more" wx:if="{{loading}}">
    <view class="loading-dot" />
    <view class="loading-dot" />
    <view class="loading-dot" />
  </view>

  <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">— 没有更多了 —</view>
  <view class="safe-bottom" />

  <t-date-time-picker
    visible="{{startPickerVisible}}"
    mode="date"
    format="YYYY-MM-DD"
    value="{{startDate || today}}"
    defaultValue="{{today}}"
    start="2000-01-01"
    end="2030-12-31"
    bind:confirm="onStartDateConfirm"
    bind:cancel="onStartDateCancel"
  />

  <t-date-time-picker
    visible="{{endPickerVisible}}"
    mode="date"
    format="YYYY-MM-DD"
    value="{{endDate || today}}"
    defaultValue="{{today}}"
    start="2000-01-01"
    end="2030-12-31"
    bind:confirm="onEndDateConfirm"
    bind:cancel="onEndDateCancel"
  />
</view>
