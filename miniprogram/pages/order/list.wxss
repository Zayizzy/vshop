/* ========== 订单列表页 ========== */
.page {
  min-height: 100vh;
  background: #F5F7F5;
}

/* ========== TDesign tabs 容器间距 ========== */
t-tabs {
  background: #FFFFFF;
}

/* ========== 订单列表 ========== */
.order-list {
  padding: 16rpx 0;
}

/* ========== 订单卡片 ========== */
.order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 20rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: transform 0.15s;
}

.order-card:active {
  transform: scale(0.985);
}

/* ========== 订单头部 ========== */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.order-sn {
  font-size: 24rpx;
  color: #999999;
  letter-spacing: 0.5rpx;
}

/* ========== 包裹区域 ========== */
.package-section {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.package-label {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}

.logistics-badge {
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #07C160;
  background: #E8F8EE;
  border-radius: 6rpx;
  font-weight: 500;
}

/* ========== 商品行 ========== */
.goods-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.goods-item + .goods-item {
  border-top: 1rpx solid #FAFAFA;
}

.goods-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.goods-title {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.4;
}

.goods-spec {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.goods-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.goods-price {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 600;
}

.goods-qty {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* ========== 订单底部 ========== */
.order-footer {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  padding: 16rpx 20rpx 8rpx;
  gap: 6rpx;
}

.order-total {
  font-size: 24rpx;
  color: #999999;
}

.order-footer .order-price {
  font-size: 30rpx;
  color: #FF6B35;
  font-weight: 700;
}

/* ========== 操作按钮 ========== */
.order-actions {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 20rpx 20rpx;
  gap: 14rpx;
}

/* ========== 加载 / 无更多 ========== */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  background: #07C160;
  border-radius: 50%;
  animation: loading-bounce 0.6s ease-in-out infinite alternate;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes loading-bounce {
  from { opacity: 0.3; transform: scale(0.7); }
  to   { opacity: 1;   transform: scale(1); }
}

.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 22rpx;
  color: #CCCCCC;
}

/* ========== 工具类 ========== */
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ========== 底部安全区 ========== */
.safe-bottom {
  height: 40rpx;
}
