/* home/index.wxss — 简约现代调性 */

.page {
  min-height: 100vh;
  background: #F5F7F5;
}

/* ===== 导航栏 ===== */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #FFFFFF;
  gap: 20rpx;
}

.nav-city {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 8rpx 0;
}

.city-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.nav-search {
  flex: 1;
  pointer-events: none;
}

.nav-search .t-search {
  pointer-events: auto;
}

/* ===== 截单倒计时（胶囊条） ===== */
.cutoff-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 16rpx 28rpx 0;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE8D6 100%);
  border-radius: 100rpx;
  font-size: 24rpx;
}

.cutoff-text {
  color: #FF6B35;
  font-weight: 600;
}

.cutoff-date {
  color: #B8896B;
  font-size: 22rpx;
}

/* ===== Banner ===== */
.banner {
  width: 100%;
  height: 280rpx;
  padding: 20rpx 28rpx 0;
  box-sizing: border-box;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  overflow: hidden;
}

/* 有图片的轮播图：图片铺满，不再居中文字 */
.banner-item-img {
  align-items: stretch;
  justify-content: flex-start;
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 渐变叠加层，让纯色 banner 更有质感 */
.banner-item::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.18) 0%, rgba(0,0,0,0.12) 100%);
}

.banner-text {
  text-align: center;
  position: relative;
  z-index: 1;
  padding: 0 32rpx;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.18);
  line-height: 1.5;
}

.banner-dots {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10rpx;
  z-index: 2;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.45);
  transition: all 0.3s;
}

.dot-active {
  width: 28rpx;
  border-radius: 6rpx;
  background: #FFFFFF;
}

/* ===== 分类网格 ===== */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 28rpx 20rpx 12rpx;
  background: #FFFFFF;
  margin: 20rpx 28rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(20, 40, 30, 0.04);
}

.cate-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.cate-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.cate-emoji {
  font-size: 42rpx;
}

.cate-name {
  font-size: 22rpx;
  color: #555;
}

/* ===== 区块标题 ===== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 28rpx 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #07C160 0%, #06AD55 100%);
  border-radius: 4rpx;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #999;
}

/* ===== 商品网格（两列） ===== */
.goods-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 28rpx;
}

/* ===== 通用 ===== */
.safe-bottom {
  height: 48rpx;
}

/* ===== 图标 ===== */
.icon-loc {
  font-size: 26rpx;
  line-height: 1;
}

.icon-arrow-down {
  font-size: 20rpx;
  color: #999;
  line-height: 1;
}

.icon-arrow {
  font-size: 28rpx;
  color: #999;
  font-weight: 300;
  line-height: 1;
}

.icon-time {
  font-size: 24rpx;
  line-height: 1;
}

.list-loading {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 48rpx 0 24rpx;
  color: #C8C8C8;
  font-size: 24rpx;
}
