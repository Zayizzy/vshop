@import '/styles/theme.wxss';
@import '/styles/common.wxss';

.page {
  min-height: 100vh;
  background: var(--t-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.status-card {
  background: var(--t-card);
  border-radius: var(--r-md);
  margin: 0 var(--s-xl);
  padding: 80rpx var(--s-xl) var(--s-xl);
  width: 580rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.status-icon-wrap {
  margin-bottom: var(--s-xl);
}

/* 审核中动画 */
.pending-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid var(--t-border);
  border-top-color: var(--t-accent);
  animation: spin 1.2s linear infinite;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pending-dot {
  width: 16rpx;
  height: 16rpx;
  background: var(--t-accent);
  border-radius: 50%;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 通过 */
.success-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--t-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-icon {
  font-size: 60rpx;
  color: #fff;
  font-weight: 700;
}

/* 拒绝 */
.reject-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--t-danger);
  display: flex;
  align-items: center;
  justify-content: center;
}

.reject-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 700;
}

.status-title {
  font-size: var(--f-title);
  font-weight: 600;
  color: var(--t-text);
  margin-bottom: var(--s-md);
}

.status-title.green {
  color: var(--t-primary);
}

.status-title.red {
  color: var(--t-danger);
}

.status-desc {
  font-size: var(--f-body);
  color: var(--t-text-secondary);
  margin-bottom: var(--s-sm);
  line-height: 1.6;
}

.status-tip {
  font-size: var(--f-caption);
  color: var(--t-text-hint);
  margin-top: var(--s-md);
}

.go-btn {
  width: 100%;
  margin-top: var(--s-xl);
}

.reapply-area {
  margin-top: var(--s-xl);
  width: 100%;
}

.reapply-tip {
  font-size: var(--f-caption);
  color: var(--t-text-hint);
  display: block;
  margin-bottom: var(--s-md);
}

.reapply-btn {
  width: 100%;
}

/* 未申请 */
.status-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-title {
  font-size: var(--f-title);
  font-weight: 600;
  color: var(--t-text);
  margin-bottom: var(--s-md);
}

.empty-desc {
  font-size: var(--f-body);
  color: var(--t-text-hint);
  margin-bottom: var(--s-xl);
}

/* 加载 */
.loading-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--t-border);
  border-top-color: var(--t-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  margin-top: var(--s-md);
  font-size: var(--f-caption);
  color: var(--t-text-hint);
}
