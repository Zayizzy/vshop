<view class="page">
  <view class="status-card" wx:if="{{loaded}}">
    <!-- 审核中 -->
    <view class="status-pending" wx:if="{{status === 0}}">
      <view class="status-icon-wrap">
        <view class="pending-ring">
          <view class="pending-dot"></view>
        </view>
      </view>
      <text class="status-title">审核中</text>
      <text class="status-desc">您的分销员申请正在审核，请耐心等待</text>
      <text class="status-tip">预计 1-3 个工作日内完成审核</text>
    </view>

    <!-- 已通过 -->
    <view class="status-passed" wx:if="{{status === 1}}">
      <view class="status-icon-wrap">
        <view class="success-circle">
          <text class="success-icon">✓</text>
        </view>
      </view>
      <text class="status-title green">恭喜，申请已通过</text>
      <text class="status-desc">您已正式成为鲜到家分销员</text>
      <button class="btn-primary go-btn" bindtap="goDashboard">进入工作台</button>
    </view>

    <!-- 已驳回 -->
    <view class="status-rejected" wx:if="{{status === 2}}">
      <view class="status-icon-wrap">
        <view class="reject-circle">
          <text class="reject-icon">✕</text>
        </view>
      </view>
      <text class="status-title red">申请已驳回</text>
      <text class="status-desc" wx:if="{{reason}}">驳回原因：{{reason}}</text>
      <view class="reapply-area">
        <text class="reapply-tip">可根据驳回原因修改后重新提交</text>
        <button class="btn-primary reapply-btn" bindtap="reapply">重新申请</button>
      </view>
    </view>
  </view>

  <!-- 未申请 -->
  <view class="status-card" wx:if="{{loaded && status === -1}}">
    <view class="status-empty">
      <text class="empty-title">暂未申请</text>
      <text class="empty-desc">您还没有提交分销员申请</text>
      <button class="btn-primary" bindtap="goRegister">立即申请</button>
    </view>
  </view>

  <view class="loading-center" wx:if="{{!loaded}}">
    <view class="spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>
