.page { min-height: 100vh; background: #F5F7F5; display: flex; flex-direction: column; align-items: center; }

.poster-container { width: 100%; display: flex; flex-direction: column; align-items: center; padding: 32rpx 0; }
.poster-preview { background: #FFFFFF; border-radius: 16rpx; overflow: hidden; box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.1); padding: 20rpx; }
.poster-tips { text-align: center; margin: 24rpx 0; font-size: 24rpx; color: #999; }
.poster-tips text { display: block; line-height: 1.8; }

.poster-actions { width: 100%; padding: 0 40rpx; display: flex; flex-direction: column; gap: 16rpx; }
.poster-actions t-button { width: 100%; }

.loading-poster { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; gap: 24rpx; }
.loading-spin { width: 80rpx; height: 80rpx; border: 4rpx solid #E5EBE5; border-top-color: #07C160; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #999; }
