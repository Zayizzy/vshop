<view class="page">
  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-val">¥128.50</text>
      <text class="stat-label">累计佣金</text>
    </view>
    <view class="stat-divider" />
    <view class="stat-item">
      <text class="stat-val">45</text>
      <text class="stat-label">推广订单</text>
    </view>
    <view class="stat-divider" />
    <view class="stat-item">
      <text class="stat-val">¥36.80</text>
      <text class="stat-label">待结算</text>
    </view>
  </view>

  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <view class="order-row">
        <t-image src="{{item.goodsImage}}" width="80rpx" height="80rpx" mode="aspectFill" shape="round" />
        <view class="order-info">
          <text class="order-title">{{item.goodsTitle}}</text>
          <text class="order-time">{{item.createdAt}}</text>
        </view>
        <t-tag theme="{{getStatusTheme(item.status)}}" size="small" variant="light">{{getStatusText(item.status)}}</t-tag>
      </view>
      <view class="order-price-row">
        <text class="order-amount">订单金额 ¥{{item.orderAmount}}</text>
        <text class="order-commission">佣金 ¥{{item.commission}}</text>
      </view>
    </view>
  </view>

  <t-empty wx:elif="{{!loading}}" icon="order" description="暂无推广订单" />
</view>
