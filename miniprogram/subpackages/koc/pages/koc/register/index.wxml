<view class="page">
  <view class="form-card">
    <view class="form-group">
      <view class="form-label">真实姓名</view>
      <input class="form-input" placeholder="请输入真实姓名" value="{{realName}}" bindinput="onInput" data-field="realName" maxlength="20" />
    </view>
    <view class="form-group">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" placeholder="自动获取" value="{{phone}}" bindinput="onInput" data-field="phone" maxlength="11" disabled="{{phoneAuto}}" />
      <view class="phone-tip" wx:if="{{phoneAuto}}">已通过微信授权自动获取</view>
    </view>
    <view class="form-group">
      <view class="form-label">社交账号</view>
      <input class="form-input" placeholder="请输入微信号/小红书号等" value="{{socialAccount}}" bindinput="onInput" data-field="socialAccount" maxlength="50" />
      <view class="form-hint">用于展示您的推广渠道信息</view>
    </view>
    <view class="form-group">
      <view class="form-label">个人介绍</view>
      <textarea class="form-textarea" placeholder="请介绍您的推广优势与经验（选填）" value="{{introduction}}" bindinput="onInput" data-field="introduction" maxlength="300" />
      <view class="form-counter">{{introduction.length}}/300</view>
    </view>
  </view>

  <view class="agreement-section">
    <view class="agreement-row" bindtap="toggleAgree">
      <view class="checkbox {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}" class="check-icon">✓</text>
      </view>
      <text class="agreement-text">我已阅读并同意</text>
      <text class="agreement-link" catchtap="showAgreement">《分销合作协议》</text>
    </view>
  </view>

  <view class="btn-area">
    <button class="btn-primary" bindtap="submit" disabled="{{!agreed || submiting || !realName || !phone}}">
      {{submiting ? '提交中...' : '提交申请'}}
    </button>
  </view>
</view>
