<view class="page">
  <!-- 自定义导航栏 -->
  <nav-bar title="KOC分销员工作台">
    <view slot="right" class="nav-right" bindtap="goStatus">
      <text class="nav-right-text">查看状态</text>
    </view>
  </nav-bar>

  <!-- 橙色头部卡片 -->
  <view class="header-card">
    <view class="header-top">
      <text class="balance-label">可提现余额</text>
      <text class="balance-value">¥{{balance}}</text>
    </view>
    <button class="withdraw-btn" bindtap="goWithdraw">立即提现</button>
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">¥{{pendingAmount}}</text>
        <text class="stat-label">待结算</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{totalOrders}}</text>
        <text class="stat-label">累计订单</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">¥{{totalGmv}}</text>
        <text class="stat-label">累计GMV</text>
      </view>
    </view>
  </view>

  <!-- 今日数据 -->
  <view class="card daily-card">
    <text class="card-title">今日数据</text>
    <view class="daily-grid">
      <view class="daily-item">
        <text class="daily-value">{{todayExposure}}</text>
        <text class="daily-label">曝光</text>
      </view>
      <view class="daily-item">
        <text class="daily-value">{{todayClicks}}</text>
        <text class="daily-label">点击</text>
      </view>
      <view class="daily-item">
        <text class="daily-value">{{todayOrders}}</text>
        <text class="daily-label">下单</text>
      </view>
    </view>
  </view>

  <!-- 功能工具 -->
  <view class="tool-grid">
    <view class="tool-item" bindtap="goShare">
      <view class="tool-icon green-bg">
        <text class="tool-icon-text">📢</text>
      </view>
      <text class="tool-title">商品推广</text>
      <text class="tool-desc">选品生成推广素材</text>
    </view>
    <view class="tool-item" bindtap="goCode">
      <view class="tool-icon orange-bg">
        <text class="tool-icon-text">📱</text>
      </view>
      <text class="tool-title">推广码</text>
      <text class="tool-desc">小程序推广码</text>
    </view>
    <view class="tool-item" bindtap="goPoster">
      <view class="tool-icon blue-bg">
        <text class="tool-icon-text">🎨</text>
      </view>
      <text class="tool-title">海报生成</text>
      <text class="tool-desc">自定义推广海报</text>
    </view>
    <view class="tool-item" bindtap="goMaterials">
      <view class="tool-icon purple-bg">
        <text class="tool-icon-text">📦</text>
      </view>
      <text class="tool-title">素材库</text>
      <text class="tool-desc">官方素材直接取用</text>
    </view>
  </view>

  <!-- 推广订单 -->
  <view class="card order-card">
    <view class="card-header">
      <text class="card-title">推广订单</text>
      <text class="card-more" bindtap="goOrders">全部 ></text>
    </view>
    <view class="order-list" wx:if="{{orders.length > 0}}">
      <view class="order-item" wx:for="{{orders}}" wx:key="id">
        <view class="order-info">
          <text class="order-product">{{item.productName}}</text>
          <text class="order-time">{{item.createTime}}</text>
        </view>
        <view class="order-amount">
          <text class="order-price">¥{{item.orderAmount}}</text>
          <text class="order-commission">佣金 ¥{{item.commission}}</text>
        </view>
      </view>
    </view>
    <view class="order-empty" wx:elif="{{loaded}}">
      <text>暂无推广订单</text>
    </view>
  </view>

  <!-- 常用分享入口 -->
  <view class="share-bar">
    <button class="share-btn" open-type="share">
      <text class="share-icon">💬</text>
      <text class="share-text">分享到群</text>
    </button>
    <button class="share-btn" bindtap="shareToTimeline">
      <text class="share-icon">🔄</text>
      <text class="share-text">朋友圈</text>
    </button>
    <button class="share-btn" bindtap="copyLink">
      <text class="share-icon">📋</text>
      <text class="share-text">复制链接</text>
    </button>
  </view>

  <view class="safe-bottom"></view>
</view>
