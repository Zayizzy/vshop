@import '/styles/theme.wxss';
@import '/styles/common.wxss';

/* 自定义导航 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx var(--s-lg);
  background: var(--t-accent);
  color: #fff;
}

.nav-title {
  font-size: var(--f-h2);
  font-weight: 600;
  color: #fff;
}

.nav-right-text {
  font-size: var(--f-caption);
  color: rgba(255,255,255,0.85);
}

/* 橙色头部 */
.header-card {
  background: linear-gradient(135deg, #FF6B35, #FF8C63);
  padding: var(--s-lg) var(--s-lg) var(--s-xl);
  margin: 0 var(--s-sm);
  border-radius: var(--r-lg);
  color: #fff;
}

.header-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--s-lg);
}

.balance-label {
  font-size: var(--f-caption);
  opacity: 0.85;
}

.balance-value {
  font-size: 56rpx;
  font-weight: 700;
  margin-top: var(--s-xs);
}

.withdraw-btn {
  width: 280rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: rgba(255,255,255,0.25);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--r-round);
  border: none;
  margin: 0 auto var(--s-xl);
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
}

.stat-label {
  font-size: var(--f-small);
  opacity: 0.8;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.3);
}

/* 今日数据 */
.daily-card {
  margin-top: var(--s-sm);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t-text);
  margin-bottom: var(--s-md);
}

.daily-grid {
  display: flex;
  justify-content: space-around;
}

.daily-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.daily-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--t-accent);
}

.daily-label {
  font-size: var(--f-caption);
  color: var(--t-text-hint);
  margin-top: 8rpx;
}

/* 工具网格 */
.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-sm);
  margin: var(--s-sm) var(--s-sm);
}

.tool-item {
  background: var(--t-card);
  border-radius: var(--r-md);
  padding: var(--s-lg);
  display: flex;
  flex-direction: column;
}

.tool-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--s-sm);
}

.tool-icon-text {
  font-size: 36rpx;
}

.green-bg { background: var(--t-primary-bg); }
.orange-bg { background: var(--t-accent-bg); }
.blue-bg { background: #E3F2FD; }
.purple-bg { background: #F3E5F5; }

.tool-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--t-text);
  margin-bottom: 4rpx;
}

.tool-desc {
  font-size: var(--f-small);
  color: var(--t-text-hint);
}

/* 订单列表 */
.order-card {
  margin-top: var(--s-sm);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--s-md);
}

.card-more {
  font-size: var(--f-caption);
  color: var(--t-primary);
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--s-sm) 0;
  border-bottom: 1rpx solid var(--t-divider);
}

.order-item:last-child {
  border-bottom: none;
}

.order-info {
  flex: 1;
  overflow: hidden;
}

.order-product {
  font-size: var(--f-body);
  color: var(--t-text);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-time {
  font-size: var(--f-small);
  color: var(--t-text-hint);
  display: block;
  margin-top: 4rpx;
}

.order-amount {
  text-align: right;
  flex-shrink: 0;
  margin-left: var(--s-md);
}

.order-price {
  font-size: var(--f-body);
  color: var(--t-text);
  font-weight: 500;
  display: block;
}

.order-commission {
  font-size: var(--f-small);
  color: var(--t-accent);
  display: block;
  margin-top: 4rpx;
}

.order-empty {
  text-align: center;
  padding: var(--s-xl) 0;
  color: var(--t-text-hint);
  font-size: var(--f-caption);
}

/* 分享栏 */
.share-bar {
  display: flex;
  justify-content: space-around;
  margin: var(--s-sm) var(--s-sm);
  padding: var(--s-md);
  background: var(--t-card);
  border-radius: var(--r-md);
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  background: none;
  border: none;
  line-height: 1;
  font-size: inherit;
}

.share-btn::after {
  border: none;
}

.share-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.share-text {
  font-size: var(--f-small);
  color: var(--t-text-secondary);
}

.safe-bottom {
  height: 40rpx;
}
