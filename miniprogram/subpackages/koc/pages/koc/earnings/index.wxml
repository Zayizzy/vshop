<view class="page">
  <!-- 收益概览 -->
  <view class="summary-card">
    <text class="summary-label">累计收益 (元)</text>
    <text class="summary-value">¥{{totalEarnings}}</text>
    <view class="summary-row">
      <text class="summary-pending">待结算 ¥{{pendingEarnings}}</text>
      <text class="summary-settled">已结算 ¥{{settledEarnings}}</text>
    </view>
  </view>

  <!-- 标签切换 -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 收益列表 -->
  <view class="list-wrap">
    <view class="earnings-item" wx:for="{{list}}" wx:key="id">
      <view class="item-left">
        <text class="item-product text-ellipsis">{{item.productName}}</text>
        <text class="item-time">{{item.createTime}}</text>
      </view>
      <view class="item-right">
        <text class="item-order-amount">订单 ¥{{item.orderAmount}}</text>
        <text class="item-commission">佣金 ¥{{item.commission}}</text>
        <view class="status-badge {{item.statusClass}}">
          <text>{{item.statusText}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{loaded && list.length === 0}}">
      <text class="empty-icon">💰</text>
      <text class="empty-text">暂无收益记录</text>
    </view>

    <view class="load-more" wx:if="{{hasMore}}">
      <text class="load-text" bindtap="loadMore">加载更多</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && list.length > 0}}">
      <text class="no-more-text">没有更多了</text>
    </view>

    <view class="loading-center" wx:if="{{!loaded}}">
      <view class="spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
