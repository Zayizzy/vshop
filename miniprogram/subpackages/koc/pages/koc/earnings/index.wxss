@import '/styles/theme.wxss';
@import '/styles/common.wxss';

.page {
  min-height: 100vh;
  background: var(--t-bg);
}

/* 收益概览 */
.summary-card {
  background: linear-gradient(135deg, var(--t-primary), #05B055);
  padding: var(--s-xl) var(--s-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.summary-label {
  font-size: var(--f-caption);
  opacity: 0.85;
}

.summary-value {
  font-size: 52rpx;
  font-weight: 700;
  margin: var(--s-sm) 0;
}

.summary-row {
  display: flex;
  gap: var(--s-xl);
}

.summary-pending,
.summary-settled {
  font-size: var(--f-small);
  opacity: 0.8;
}

/* 标签切换 */
.tabs {
  display: flex;
  background: var(--t-card);
  padding: 0 var(--s-sm);
  border-bottom: 1rpx solid var(--t-divider);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: var(--s-md) 0;
  font-size: var(--f-body);
  color: var(--t-text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--t-primary);
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--t-primary);
  border-radius: 2rpx;
}

/* 列表 */
.list-wrap {
  padding: 0 var(--s-sm);
}

.earnings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--s-md) 0;
  border-bottom: 1rpx solid var(--t-divider);
}

.item-left {
  flex: 1;
  overflow: hidden;
  margin-right: var(--s-md);
}

.item-product {
  font-size: var(--f-body);
  color: var(--t-text);
  display: block;
}

.item-time {
  font-size: var(--f-small);
  color: var(--t-text-hint);
  display: block;
  margin-top: 4rpx;
}

.item-right {
  text-align: right;
  flex-shrink: 0;
}

.item-order-amount {
  font-size: var(--f-small);
  color: var(--t-text-hint);
  display: block;
}

.item-commission {
  font-size: var(--f-body);
  color: var(--t-accent);
  font-weight: 500;
  display: block;
  margin: 4rpx 0;
}

/* 状态徽章 */
.status-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
}

.status-badge.settled {
  background: var(--t-primary-bg);
  color: var(--t-primary);
}

.status-badge.pending {
  background: #FFF3E0;
  color: var(--t-accent);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: var(--s-md);
}

.empty-text {
  font-size: var(--f-body);
  color: var(--t-text-hint);
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: var(--s-lg) 0;
}

.load-text {
  font-size: var(--f-caption);
  color: var(--t-primary);
}

.no-more-text {
  font-size: var(--f-small);
  color: var(--t-text-disabled);
}

.loading-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--t-border);
  border-top-color: var(--t-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--s-md);
  font-size: var(--f-caption);
  color: var(--t-text-hint);
}

.safe-bottom {
  height: 40rpx;
}
