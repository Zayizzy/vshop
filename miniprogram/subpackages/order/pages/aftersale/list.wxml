<view class="page">
  <view class="tabs">
    <text class="tab {{!filter||filter==='all'?'active':''}}" bindtap="setFilter" data-filter="all">全部</text>
    <text class="tab {{filter==='pending'?'active':''}}" bindtap="setFilter" data-filter="pending">审核中</text>
    <text class="tab {{filter==='approved'?'active':''}}" bindtap="setFilter" data-filter="approved">已同意</text>
    <text class="tab {{filter==='done'?'active':''}}" bindtap="setFilter" data-filter="done">已完成</text>
  </view>
  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="flex-between"><text class="item-title">{{item.typeText}} · {{item.reason}}</text><text class="item-status" style="color:{{item.statusColor}}">{{item.statusText}}</text></view>
      <text class="item-desc">{{item.goodsTitle}} · ¥{{item.refundAmount}}</text>
      <text class="item-time">{{item.createdAt}}</text>
    </view>
    <view class="empty" wx:if="{{!list.length}}"><text>暂无售后记录</text></view>
  </view>
</view>