@import '/styles/theme.wxss';
@import '/styles/common.wxss';

.result-wrap { display: flex; flex-direction: column; align-items: center; padding: 120rpx var(--s-xl) 80rpx; }
.result-icon { font-size: 96rpx; margin-bottom: var(--s-lg); }
.result-text { font-size: 36rpx; font-weight: 500; color: var(--t-text); margin-bottom: var(--s-sm); }
.result-desc { font-size: var(--f-body); color: var(--t-text-hint); }

.btn-group { padding: 0 var(--s-lg); display: flex; flex-direction: column; gap: var(--s-sm); }
.btn-group button { border-radius: var(--r-xl); width: 100%; }
