@import '/styles/theme.wxss';
@import '/styles/common.wxss';

.form-group { margin-bottom: var(--s-lg); }
.label { font-size: var(--f-body); color: var(--t-text); display: block; margin-bottom: var(--s-xs); }
.input { width: 100%; height: 80rpx; padding: 0 var(--s-sm); background: var(--t-bg); border-radius: var(--r-sm); font-size: var(--f-body); }
.picker-val { font-size: var(--f-body); color: var(--t-text-secondary); line-height: 80rpx; }
.form-default { display: flex; align-items: center; gap: var(--s-xs); font-size: var(--f-caption); color: var(--t-text-secondary); }

.btn-wrap { padding: var(--s-lg) var(--s-md); }
.btn-wrap button { border-radius: var(--r-xl); margin-bottom: var(--s-md); }
.btn-delete { background: #fff; color: var(--t-danger); border: 1rpx solid var(--t-danger); }
