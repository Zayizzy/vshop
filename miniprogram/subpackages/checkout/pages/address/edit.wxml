<view class="page">
  <view class="card">
    <view class="form-group">
      <text class="label">收货人</text>
      <input class="input" value="{{form.name}}" placeholder="请输入收货人姓名" bindinput="setField" data-field="name" />
    </view>
    <view class="form-group">
      <text class="label">手机号</text>
      <input class="input" type="number" value="{{form.phone}}" placeholder="请输入手机号" bindinput="setField" data-field="phone" maxlength="11" />
    </view>
    <view class="form-group">
      <text class="label">所在地区</text>
      <picker mode="region" bindchange="selectRegion" value="{{region}}">
        <view class="picker-val">{{regionText || '请选择地区'}}</view>
      </picker>
    </view>
    <view class="form-group">
      <text class="label">详细地址</text>
      <input class="input" value="{{form.detail}}" placeholder="街道、门牌号等" bindinput="setField" data-field="detail" />
    </view>
    <view class="form-default">
      <checkbox checked="{{form.isDefault}}" bindtap="toggleDefault" />
      <text>设为默认地址</text>
    </view>
  </view>

  <view class="btn-wrap">
    <button class="btn-primary" bindtap="save" loading="{{saving}}">保存</button>
    <button class="btn-delete" bindtap="del" wx:if="{{editing}}">删除地址</button>
  </view>
</view>