<view class="page">
  <view class="service-header">
    <text class="header-icon">🎧</text>
    <text class="header-title">鲜到家客服中心</text>
    <text class="header-desc">服务时间：每日 8:00 - 22:00</text>
  </view>

  <view class="online-card" bindtap="goChat">
    <text class="online-icon">💬</text>
    <view class="online-info">
      <text class="online-title">在线客服咨询</text>
      <text class="online-desc">留言咨询订单/商品问题，客服尽快回复</text>
    </view>
    <text class="online-arrow">›</text>
  </view>

  <view class="contact-card">
    <view class="contact-item" bindtap="callService">
      <text class="contact-icon">📞</text>
      <view class="contact-info">
        <text class="contact-label">电话客服</text>
        <text class="contact-value">138-8888-8888</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="contact-divider" />
    <view class="contact-item" bindtap="copyWechat">
      <text class="contact-icon">💬</text>
      <view class="contact-info">
        <text class="contact-label">微信客服</text>
        <text class="contact-value">xiandaijia_kefu</text>
      </view>
      <text class="copy-text">复制</text>
    </view>
  </view>

  <view class="faq-section">
    <text class="section-title">常见问题</text>
    <view class="faq-item" wx:for="{{faqList}}" wx:key="index" bindtap="toggleFaq" data-index="{{index}}">
      <view class="faq-q">
        <text>{{item.q}}</text>
        <text class="faq-arrow {{showAnswer === index ? 'open' : ''}}">›</text>
      </view>
      <view class="faq-a" wx:if="{{showAnswer === index}}">{{item.a}}</view>
    </view>
  </view>
</view>
