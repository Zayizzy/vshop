<view class="page">
  <view class="tabs">
    <text class="tab {{tab==='usable'?'active':''}}" bindtap="switchTab" data-tab="usable">可使用</text>
    <text class="tab {{tab==='used'?'active':''}}" bindtap="switchTab" data-tab="used">已使用</text>
    <text class="tab {{tab==='expired'?'active':''}}" bindtap="switchTab" data-tab="expired">已过期</text>
  </view>
  <view class="list">
    <view class="coupon-card card" wx:for="{{list}}" wx:key="id">
      <view class="coupon-left">
        <text class="coupon-amount" wx:if="{{item.discountType === 'reduce'}}">¥{{item.discountValue}}</text>
        <text class="coupon-amount" wx:if="{{item.discountType === 'rate'}}">{{item.discountValue * 10}}折</text>
        <text class="coupon-condition">满{{item.threshold}}元可用</text>
      </view>
      <view class="coupon-right">
        <text class="coupon-name">{{item.name}}</text>
        <text class="coupon-scope">{{item.scopeText}}</text>
        <text class="coupon-date">{{item.validPeriod}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}"><text>暂无优惠券</text></view>
  </view>
</view>