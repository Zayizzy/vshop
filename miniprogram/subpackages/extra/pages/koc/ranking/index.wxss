.page { min-height: 100vh; background: #F5F7F5; }

.my-card { display: flex; margin: 16rpx 20rpx; background: linear-gradient(135deg, #FF6B35, #E8591F); border-radius: 16rpx; padding: 32rpx; align-items: center; gap: 32rpx; }
.my-rank { text-align: center; flex-shrink: 0; }
.my-rank-num { font-size: 56rpx; font-weight: 700; color: #FFFFFF; display: block; line-height: 1; }
.my-rank-label { font-size: 22rpx; color: rgba(255,255,255,0.7); margin-top: 6rpx; display: block; }
.my-info { flex: 1; }
.my-name { font-size: 32rpx; font-weight: 600; color: #FFFFFF; display: block; }
.my-detail { font-size: 24rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; display: block; }

.section-title { font-size: 28rpx; font-weight: 600; color: #333; padding: 16rpx 20rpx 8rpx; display: block; }
.podium { margin: 0 20rpx; }

.rank-item { display: flex; align-items: center; background: #FFFFFF; border-radius: 12rpx; padding: 20rpx; margin-bottom: 8rpx; gap: 16rpx; }
.rank-item.rank-1 { background: linear-gradient(90deg, #FFF8E1, #FFFFFF); }
.rank-item.rank-2 { background: linear-gradient(90deg, #F5F5F5, #FFFFFF); }
.rank-item.rank-3 { background: linear-gradient(90deg, #FFF3E0, #FFFFFF); }
.rank-badge { font-size: 32rpx; width: 56rpx; text-align: center; flex-shrink: 0; color: #999; font-weight: 600; }
.rank-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #E8F8EE; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 24rpx; color: #07C160; font-weight: 600; }
.rank-info { flex: 1; }
.rank-name { font-size: 26rpx; color: #333; display: block; }
.rank-detail { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.rank-earnings { font-size: 28rpx; font-weight: 600; color: #FF6B35; }
