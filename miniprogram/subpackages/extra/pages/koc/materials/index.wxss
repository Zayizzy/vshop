.page { min-height: 100vh; background: #F5F7F5; }

.tabs { display: flex; background: #FFFFFF; padding: 0 20rpx; border-bottom: 1rpx solid #F0F0F0; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #666; position: relative; }
.tab-item.active { color: #07C160; font-weight: 600; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 48rpx; height: 4rpx; background: #07C160; border-radius: 2rpx; }

.card { background: #FFFFFF; margin: 16rpx 20rpx; border-radius: 16rpx; padding: 24rpx; }
.card-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.type-tag { font-size: 20rpx; color: #07C160; background: #E8F8EE; padding: 4rpx 12rpx; border-radius: 6rpx; flex-shrink: 0; }
.card-title { font-size: 28rpx; font-weight: 500; color: #333; }
.card-content { font-size: 26rpx; color: #666; line-height: 1.8; display: block; }
.card-image { border-radius: 12rpx; margin-top: 16rpx; }
.card-actions { display: flex; justify-content: flex-end; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #F5F5F5; gap: 24rpx; }
.action-btn { font-size: 24rpx; color: #07C160; padding: 8rpx 0; }
