.page { min-height: 100vh; background: #F5F7F5; }

.stats-header { display: flex; margin: 16rpx 20rpx; background: linear-gradient(135deg, #07C160, #05A050); border-radius: 16rpx; padding: 40rpx 0; }
.stat-block { flex: 1; text-align: center; }
.stat-num { font-size: 44rpx; font-weight: 700; color: #FFFFFF; display: block; }
.stat-num.new { font-size: 36rpx; color: #FFE082; }
.stat-label { font-size: 22rpx; color: rgba(255,255,255,0.7); margin-top: 8rpx; display: block; }
.stat-divider-v { width: 2rpx; background: rgba(255,255,255,0.2); align-self: center; height: 64rpx; }

.fan-item { display: flex; align-items: center; background: #FFFFFF; margin: 0 20rpx 8rpx; border-radius: 12rpx; padding: 24rpx; gap: 16rpx; }
.fan-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #E8F8EE; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.avatar-text { font-size: 28rpx; font-weight: 600; color: #07C160; }
.fan-info { flex: 1; }
.fan-name { font-size: 26rpx; color: #333; display: block; }
.fan-date { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.fan-stats { text-align: right; }
.fan-orders { font-size: 24rpx; color: #666; display: block; }
.fan-amount { font-size: 28rpx; font-weight: 600; color: #FF6B35; margin-top: 4rpx; display: block; }

.tip-card { background: #FFF3E0; margin: 24rpx 20rpx; border-radius: 16rpx; padding: 24rpx; }
.tip-title { font-size: 26rpx; font-weight: 600; color: #FF6B35; display: block; margin-bottom: 12rpx; }
.tip-text { font-size: 24rpx; color: #E65100; line-height: 1.8; opacity: 0.8; }
