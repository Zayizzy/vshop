.page { min-height: 100vh; background: #F5F7F5; padding: 16rpx 0; }

.goods-grid { display: flex; flex-wrap: wrap; padding: 0 20rpx; gap: 16rpx; }

.goods-card {
  width: calc((100% - 16rpx) / 2);
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: transform 0.15s;
}
.goods-card:active { transform: scale(0.97); }

.img-wrap { position: relative; width: 100%; height: 280rpx; overflow: hidden; background: #E8F8EE; }

.goods-title { font-size: 26rpx; font-weight: 500; color: #333; padding: 16rpx 16rpx 8rpx; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.goods-footer { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 16rpx 20rpx; }

.price-block { display: flex; align-items: baseline; }
.price-symbol { font-size: 22rpx; font-weight: 700; color: #FF6B35; }
.price-value { font-size: 32rpx; font-weight: 700; color: #FF6B35; }

.uncollect-btn { font-size: 20rpx; color: #CCCCCC; padding: 4rpx 12rpx; border: 1rpx solid #E5EBE5; border-radius: 20rpx; }
.uncollect-btn:active { color: #FF6B35; border-color: #FF6B35; }

.safe-bottom { height: 40rpx; }
